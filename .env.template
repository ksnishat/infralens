# InfraLens - Environment Variables Template

# App
APP_NAME=infralens
APP_VERSION=2.0.0
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/infralens.log
APP_LOG_COLORS=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model
MODEL_PATH=src/ai_models/rust_v8s_best.pt
CONFIDENCE_THRESHOLD=0.25

# Ollama / Llama 3
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090