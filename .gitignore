!.env.example
!.env.template

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb.gz

# --- Logs ---
logs/
*.log

# --- AI Models & Datasets (DO NOT COMMIT) ---
"Rust Detection.v1i.yolov8/"
*.v1i.yolov8/
runs/
*.pt
*.pth
*.pkl
*.onnx
*.h5
ai_models/
# A bare `core` pattern matches any path component named `core`, including the
# src/core/ package — which silently excluded src/core/agent.py and its
# __init__.py from the repository. The API imports that module inside a
# try/except that only prints a warning, so a checkout without it degraded to
# a template safety report instead of failing. Anchor the pattern to core
# dumps at the repository root instead.
/core
core.[0-9]*

# --- Test artifacts ---
coverage.xml
.coverage

# --- User Uploads ---
uploaded_images/

# --- DVC ---
.dvc/cache/
.dvc/tmp/

# --- Tests ---
.pytest_cache/
.coverage
htmlcov/

# --- OS ---
Thumbs.db

# --- MLflow ---
mlruns/
mlflow.db
mlflow.db.bak-*

# --- MinIO local data (created by start_all_stacks.sh) ---
.minio-data/

# --- live stack logs (created by run_stack.sh) ---
.stack-logs/

# Terraform local state and cached providers must never be committed: state
# contains every resource attribute, including passwords the provider stores.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Lock generator writes its intermediate report here if run without an arg
/tmp/_lock_report.json
